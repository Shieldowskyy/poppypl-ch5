msgctxt "DT_DIA_Outimal_01_Line_00001/1_Line"
msgid "Put a hole in their neck and bring them to the boilers for Bron."
msgstr ""

msgctxt "DT_DIA_Outimal_01_Line_00005/1_Line"
msgid "Arrrgrgghhh!"
msgstr ""

msgctxt "DT_DIA_Outimal_01_Line_00010/1_Line"
msgid "Arrrgrgghhh!"
msgstr ""

msgctxt "DT_DIA_Outimal_02_Line_00001/1_Line"
msgid "I think someone is lost..."
msgstr ""

msgctxt "DT_DIA_Outimal_03_Line_00001/1_Line"
msgid "Don't. No light."
msgstr ""

msgctxt "DT_DIA_Outimal_03_Line_00005/1_Line"
msgid "Spare any food?"
msgstr ""

msgctxt "DT_DIA_Outimal_04_Line_00001/1_Line"
msgid "Someone from above."
msgstr ""

msgctxt "DT_DIA_Outimal_04_Line_00005/1_Line"
msgid "Can't trust the Judge. Can't trust any of em' not like us."
msgstr ""

msgctxt "DT_DIA_Outimal_05_Line_00001/1_Line"
msgid "There is no above. The Judge said."
msgstr ""

msgctxt "DT_DIA_Outimal_05_Line_00005/1_Line"
msgid "Who is that?"
msgstr ""

msgctxt "DT_DIA_Outimal_06_Line_00001/1_Line"
msgid "Find your own."
msgstr ""

msgctxt "DT_DIA_Outimal_06_Line_00005/1_Line"
msgid "I SAID THAT'S MINE."
msgstr ""

msgctxt "DT_DIA_Outimal_06_Line_00010/1_Line"
msgid "When Bron eats, we all eat."
msgstr ""

msgctxt "DT_DIA_Outimal_06_Line_00015/1_Line"
msgid "Joymaker..."
msgstr ""

msgctxt "DT_DIA_Poppy_BARK_Humming_01/1_Line"
msgid "(Humming the Poppy theme)"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/4_Line"
msgid ""
"For running away. For not letting you leave at the Game Station. For... "
"everything."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/3_Line"
msgid "I am, sorry..."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/5_Line"
msgid "I thought if we could just get the orphans out..."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/2_Line"
msgid ""
"I... I know saying I'm sorry won't mean much to you at this point, but..."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/7_Line"
msgid "If you can help us get out. Maybe find a lever or a key. Anything."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/1_Line"
msgid "It's you... You're... alive."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00001/6_Line"
msgid ""
"We tried to cross Sweet Street. I didn't know she was still here after all "
"this time."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00015/1_Line"
msgid "Hide."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00020/1_Line"
msgid "I don't know what she's planning, but we need to find a way out of here."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00020/2_Line"
msgid "See what you can do. "
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00021/1_Line"
msgid "Shh. Shh. You'll be okay, I promise."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00022/1_Line"
msgid "Maybe this is...Kissy, it's all wrong..."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00023/1_Line"
msgid "Shh. Shh. You'll be okay, I promise."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00025/1_Line"
msgid "You did it! Let's get out of here, before she comes back."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00026/1_Line"
msgid "It doesn't look like there's a way out for us in this basement, Kissy."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00040/2_Line"
msgid "How... bad is it?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00040/1_Line"
msgid "How... how..."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00045/1_Line"
msgid "Giblet? Is that you?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00050/1_Line"
msgid "What did he do to you?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00060/2_Line"
msgid "I'll talk to her. You should get to looking for the backup."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00060/1_Line"
msgid ""
"What did Doey say? We’re not just things gone wrong? Do you think that's true?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00065/1_Line"
msgid "Did you find a way to free us yet?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00070/1_Line"
msgid "Found anything?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00075/1_Line"
msgid "Please, hurry..."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00080/1_Line"
msgid ""
"Did you find a way to get this door open? We need to get to the attic! That’s "
"our way out!"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00084/1_Line"
msgid "Let's get out of here."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00085/1_Line"
msgid "NO! "
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00090/1_Line"
msgid "Maybe there's a way upstairs."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00095/1_Line"
msgid "We can't wait around! We have to go!"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00100/1_Line"
msgid "What?!... What's going on?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00105/1_Line"
msgid "What did you do with them?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00105/2_Line"
msgid "Where are the orphans?"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00106/1_Line"
msgid "I think it's this way."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00110/1_Line"
msgid "No... "
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00110/2_Line"
msgid "You're a monster!"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00111/1_Line"
msgid "We found a way out, hurry."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00115/1_Line"
msgid "You're hurting me."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00116/1_Line"
msgid "No, NOO -- (muffles)"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00120/1_Line"
msgid "Stop."
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00130/1_Line"
msgid "Hurry!"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00135/1_Line"
msgid "Now, Giblet!"
msgstr ""

msgctxt "DT_DIA_Poppy_Line_00140/1_Line"
msgid "What are you-- (Slight scream as the pair jumps from the train)"
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00001/4_Line"
msgid "Find me Poppy. Before she does something she'll regret."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00001/3_Line"
msgid ""
"I need you to repair the security system. Make sure there are eyes... "
"everywhere. Then..."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00001/1_Line"
msgid "I thought I'd find you... hiding...in here."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00001/2_Line"
msgid "My hunters... shall pursue one one seven zero. But you... "
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00001/5_Line"
msgid "Nothing is more important to you than this... "
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00001/6_Line"
msgid "and you know the price... for failure."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00020/1_Line"
msgid "...Poppy."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00025/1_Line"
msgid "I did...what I had to. They're in... a Better Place now."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00030/2_Line"
msgid "And plotting to destroy the only heaven you and I will ever get."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00030/1_Line"
msgid ""
"I built us a home and kept us safe. And you repaid me by bringing in an "
"outsider..."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00035/1_Line"
msgid "I had hoped your time in the case would help you see reason."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00040/1_Line"
msgid "I see now this was my fault."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00045/1_Line"
msgid "You act like a child because... a child is what they made you."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00050/1_Line"
msgid "Don't be afraid. I can fix you, Poppy."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00050/2_Line"
msgid "I can make you better."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00055/1_Line"
msgid "And you. The outsider. The Butcher, they call you."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00055/2_Line"
msgid "Shall we see what you look like, wrongside out?"
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00060/1_Line"
msgid "Don't touch her."
msgstr ""

msgctxt "DT_DIA_Prototype_Line_00065/1_Line"
msgid "Put her down."
msgstr ""


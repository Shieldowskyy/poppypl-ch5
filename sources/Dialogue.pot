msgctxt "DT_DIA_Cassette_ElliotPrototype_wav/5_Line"
msgid "If you want to talk,"
msgstr ""

msgctxt "DT_DIA_Cassette_ElliotPrototype_wav/14_Line"
msgid "It was for her."
msgstr ""


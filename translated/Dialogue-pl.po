msgctxt "DT_DIA_BARK_OS_Lily_09/1_Line"
msgid "(Humming)"
msgstr "(Nucenie)"

msgctxt "DT_DIA_BARK_OS_Lily_10/1_Line"
msgid "(Humming)"
